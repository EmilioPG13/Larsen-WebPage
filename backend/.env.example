# PostgreSQL Database Connection URL (Prisma)
# Local: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Production: injected by the Neon integration in the Vercel project.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/larsen_db?schema=public"

# JSON Web Token Secret for Admin authentication.
# Production must use a random 32+ byte secret, never this placeholder.
JWT_SECRET="larsen-italiana-secure-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Port (local only, ignored on Vercel)
PORT=3001

# Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://larsenitaliana.com,https://www.larsenitaliana.com"

# Admin account created by `npm run seed`. Minimum 12 characters.
# There is no public registration endpoint: the seed is the only way in.
ADMIN_EMAIL="admin@larsenitaliana.com"
ADMIN_PASSWORD=""
