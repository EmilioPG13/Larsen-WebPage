# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/larsen_db?schema=public"

# JSON Web Token Secret for Admin authentication
JWT_SECRET="larsen-italiana-secure-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=3001

# Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://larsenitaliana.com"
