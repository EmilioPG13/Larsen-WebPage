# PostgreSQL Database Connection URL (Prisma)
# Local: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Production: injected by the Neon integration in the Vercel project.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/larsen_db?schema=public"

# JSON Web Token Secret for Admin authentication.
# Production must use a random 32+ byte secret, never this placeholder.
JWT_SECRET="larsen-italiana-secure-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Port (local only, ignored on Vercel)
PORT=3001

# Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://larsenitaliana.com,https://www.larsenitaliana.com"

# Admin account created by `npm run seed`. Minimum 12 characters.
# There is no public registration endpoint: the seed is the only way in.
ADMIN_EMAIL="admin@larsenitaliana.com"
ADMIN_PASSWORD=""

# --- Lead notification email (all optional) ---
# When a quote request arrives, the API emails the sales team. If SMTP_USER,
# SMTP_PASS or LEAD_NOTIFY_EMAIL is empty, the notification is skipped with a
# warning and the lead is still saved.
#
# SMTP server (Google Workspace defaults; port 465 uses implicit TLS).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
# Sending account. Google Workspace rewrites the sender to this account, so
# the "from" address is always SMTP_USER. The account needs 2-step
# verification enabled and an app password (Google Account > Security >
# App passwords). Never use the account's normal password.
SMTP_USER=""
SMTP_PASS=""
# Inbox that reads the quote requests (it can be the same account as SMTP_USER).
LEAD_NOTIFY_EMAIL=""
# Public site address. The emails load the logo from it and link back to it.
SITE_URL="https://larsenitaliana.com"
# Link included in the email so the team can open the leads panel.
ADMIN_LEADS_URL="https://larsenitaliana.com/admin/leads"

# Monthly inventory report. On the 1st of each month Vercel Cron calls
# /api/cron/monthly-report and the API emails the closing of the previous month
# (same SMTP settings as above). CRON_SECRET has to be set in Vercel: it is what
# Vercel Cron sends as "Authorization: Bearer <secret>", and while it is empty the
# endpoint refuses every request. REPORT_NOTIFY_EMAIL defaults to LEAD_NOTIFY_EMAIL.
CRON_SECRET=""
REPORT_NOTIFY_EMAIL=""
ADMIN_REPORTS_URL="https://larsenitaliana.com/admin/reportes"
