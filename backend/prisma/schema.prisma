// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // rhel-openssl-3.0.x is the engine Vercel's Node runtime (Amazon Linux 2023)
  // loads. Without it the deployed function cannot start the query engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INVENTARIO
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryMovements InventoryMovement[]

  @@map("users")
}

// One row per failed login, per client IP. Kept in the database (not in memory)
// because each Vercel request can land on a different instance.
model LoginAttempt {
  id        String   @id @default(uuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  image       String
  description String
  specialties String[] // Array of strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  machines Machine[] @relation("MachineBrandRelation")
  inventoryUnits InventoryUnit[]

  @@map("brands")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       String
  image       String
  features    String[] // Array of strings
  category    String
  discount    String?
  brandId     String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand            Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  contactSubmissions ContactSubmission[]

  @@map("products")
}

model Machine {
  id              String   @id @default(uuid())
  name            String
  brand           String   // Brand name as string (from JSON data)
  description     String
  type            String
  knittingSystems String
  width           String
  speed           String
  gauge           String
  yarnGuides      String
  capabilities    String[] // Array of strings
  software        String
  power           String
  category        String
  image           String
  // Optional English overrides, mirroring the `en` block in src/data/machines.json
  // that the catalog uses to translate spec values. Kept as JSON so a machine can
  // translate only the fields that need it.
  en              Json?
  brandId         String?
  inStock         Boolean  @default(true)
  // Sold to order from Italy (e.g. Aries): listed in the catalog without
  // physical units. InventoryUnit only holds machines with a serial number.
  onOrder         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brandRelation Brand? @relation("MachineBrandRelation", fields: [brandId], references: [id], onDelete: SetNull)
  inventoryUnits InventoryUnit[]

  @@map("machines")
}

model Lead {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  // company, budget and purchaseDate are optional so a per-unit quote request
  // can be as short as name, email and phone.
  company         String?
  industry        String?
  productionVolume String?
  budget          String?
  purchaseDate    String?
  message         String?
  status          String   @default("new") // new, contacted, converted, archived
  // Set when the quote is for one physical unit of the inventory.
  inventoryUnitId String?
  serialNumber    String?
  // Where the request came from (e.g. "quote_form", "machine_interest").
  source          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryUnit InventoryUnit? @relation(fields: [inventoryUnitId], references: [id], onDelete: SetNull)

  @@index([inventoryUnitId])
  @@map("leads")
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  productId String?
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("contact_submissions")
}

enum UnitStatus {
  DISPONIBLE
  APARTADA
  VENDIDA
}

enum UnitModality {
  EN_BODEGA
  BAJO_PEDIDO
}

// One physical machine identified by its serial number.
model InventoryUnit {
  id           String       @id @default(uuid())
  brand        String // Normalized display name: "Steiger" | "Shima Seiki"
  brandId      String?
  model        String // e.g. "Vesta 130E"
  gauge        String // String because some machines are "5/7"
  serialNumber String
  status       UnitStatus   @default(DISPONIBLE)
  modality     UnitModality @default(EN_BODEGA)
  receivedAt   DateTime?
  soldAt       DateTime? // Real sale date, editable
  notes        String? // Internal only, never exposed by the public API
  machineId    String? // Spec sheet this unit belongs to, when there is one
  // Stage 2: id of the unit in the ERP (Odoo).
  externalId   String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  brandRelation Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  machine       Machine?             @relation(fields: [machineId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]
  leads         Lead[]

  // Shima uses short serials (298, 333), so a serial is only unique per brand.
  @@unique([brand, serialNumber])
  @@index([status])
  @@map("inventory_units")
}

// Audit trail: who changed which unit and when. It also measures the
// "sale -> site updated" indicator (movement createdAt vs the unit's soldAt).
model InventoryMovement {
  id         String      @id @default(uuid())
  unitId     String
  userId     String? // null = import script
  action     String // CREATE | UPDATE | STATUS | IMPORT
  fromStatus UnitStatus?
  toStatus   UnitStatus?
  changes    Json? // { field: [before, after] }
  createdAt  DateTime    @default(now())

  unit InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([unitId, createdAt])
  @@map("inventory_movements")
}
